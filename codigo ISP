library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity tb_i2s_interface is
end tb_i2s_interface;

architecture sim of tb_i2s_interface is
   
    signal clk        : std_logic := '0';
    signal bclk       : std_logic := '0';
    signal lrclk      : std_logic := '0';
    signal sdata      : std_logic := '0';
    signal sample_out : std_logic_vector(15 downto 0);


    component i2s_interface
        Port (
            clk        : in  std_logic;
            bclk       : in  std_logic;
            lrclk      : in  std_logic;
            sdata      : in  std_logic;
            sample_out : out std_logic_vector(15 downto 0)
        );
    end component;

begin
    DUT: i2s_interface
        port map (
            clk        => clk,
            bclk       => bclk,
            lrclk      => lrclk,
            sdata      => sdata,
            sample_out => sample_out
        );

    -- Generador de reloj principal
    clk_process : process
    begin
        clk <= '0';
        wait for 5 ns;
        clk <= '1';
        wait for 5 ns;
    end process;

  
    bclk_process : process
    begin
        bclk <= '0';
        wait for 10 ns;
        bclk <= '1';
        wait for 10 ns;
    end process;

    -- Generador de lrclk (cambia cada 16 bits)
    lrclk_process : process
    begin
        lrclk <= '0';
        wait for 320 ns; -- 16 ciclos de bclk * 20 ns
        lrclk <= '1';
        wait for 320 ns;
    end process;

    -- Estímulo de datos seriales
    sdata_process : process
        variable sample : std_logic_vector(15 downto 0) := "1010101010101010";
    begin
        -- Enviar una palabra de 16 bits
        for i in 15 downto 0 loop
            sdata <= sample(i);
            wait for 20 ns; -- un ciclo de bclk completo
        end loop;

        wait; 
    end process;

end sim;





